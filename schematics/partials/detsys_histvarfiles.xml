<HistVarFiles>
{{#if SBND}}

    <!-- Gain Variation -->
    <HistVarSection name="Gain_sbnd_Run1">
        <variation filename="work/{{detsys}}.root" histname="GainHigh_sbnd_Run1" knobval="-2.5"/>
        <variation filename="work/{{detsys}}.root" histname="GainLow_sbnd_Run1" knobval="2.5"/>
    </HistVarSection>
{{/if}}

    <!-- SCE: Space Charge Effect -->
{{#if SBND}}
    <HistVarSection name="SCE_sbnd_Run1">
        <variation filename="work/{{detsys}}.root" histname="SCE0x_sbnd_Run1" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="SCE2x_sbnd_Run1" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun2}}
    <HistVarSection name="SCE_icarus_Run2">
        <variation filename="work/{{detsys}}.root" histname="SCE0x_icarus_Run2" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="SCE2x_icarus_Run2" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun4}}
    <HistVarSection name="SCE_icarus_Run4">
        <variation filename="work/{{detsys}}.root" histname="SCE0x_icarus_Run4" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="SCE2x_icarus_Run4" knobval="1"/>
    </HistVarSection>
{{/if}}

    <!-- Trigger Emulation -->
{{#if SBND}}
    <HistVarSection name="TriggerEmulation_sbnd_Run1">
        <variation filename="work/{{detsys}}.root" histname="TriggerEmulationM1_sbnd_run1" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="TriggerEmulationP1_sbnd_run1" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun2}}
    <HistVarSection name="TriggerEmulation_icarus_Run2">
        <variation filename="work/{{detsys}}.root" histname="TriggerEmulationM1_icarus_run2" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="TriggerEmulationP1_icarus_run2" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun4}}
    <HistVarSection name="TriggerEmulation_icarus_Run4">
        <variation filename="work/{{detsys}}.root" histname="TriggerEmulationM1_icarus_run4" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="TriggerEmulationP1_icarus_run4" knobval="1"/>
    </HistVarSection>
{{/if}}

    <!-- Toroid Calibration -->
{{#if SBND}}
    <HistVarSection name="ToroidCalibration_sbnd_Run1">
        <variation filename="work/{{detsys}}.root" histname="ToroidCalibration_generic_RunX" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun2}}
    <HistVarSection name="ToroidCalibration_icarus_Run2">
        <variation filename="work/{{detsys}}.root" histname="ToroidCalibration_generic_RunX" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun4}}
    <HistVarSection name="ToroidCalibration_icarus_Run4">
        <variation filename="work/{{detsys}}.root" histname="ToroidCalibration_generic_RunX" knobval="1"/>
    </HistVarSection>
{{/if}}

    <!-- Protons Missing the Target -->
{{#if SBND}}
    <HistVarSection name="ProtonMiss_sbnd_Run1">
        <variation filename="work/{{detsys}}.root" histname="ProtonMissLow_generic_RunX" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="ProtonMissHigh_generic_RunX" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun2}}
    <HistVarSection name="ProtonMiss_icarus_Run2">
        <variation filename="work/{{detsys}}.root" histname="ProtonMissLow_generic_RunX" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="ProtonMissHigh_generic_RunX" knobval="1"/>
    </HistVarSection>
{{/if}}
{{#if ICARUSRun4}}
    <HistVarSection name="ProtonMiss_icarus_Run4">
        <variation filename="work/{{detsys}}.root" histname="ProtonMissLow_generic_RunX" knobval="-1"/>
        <variation filename="work/{{detsys}}.root" histname="ProtonMissHigh_generic_RunX" knobval="1"/>
    </HistVarSection>
{{/if}}

</HistVarFiles>
