    <!--
    Here we configure normalization systematics. We have two types of norms:
        - Flux normalization systematics: these correspond to an overall 2%
        uncertainty on the POT delivered by AD to the beam, as referenced in the
        MiniBooNE results.
        - Fiducial volume systematics: these correspond to a 1% uncertainty in the
        volume (the amount of "stuff") in the detector that neutrinos can
        interact with.
        - CORSIKA systematic: a simple 30% uncertainty on the out-of-time cosmic
        background, which is based on the CORSIKA simulation. This is assessed only
        for SBND because ICARUS uses overlays for cosmic background estimation.
    -->
{{#if SBND}}
    <allowlist type="norm" binning="var0" plotname="CORSIKA"           tag="Cosmic Background Normalization">.*SBND_.*cos:0.30</allowlist>
{{/if}}
    
