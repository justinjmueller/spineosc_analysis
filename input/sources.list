# Machine-specific file map for mueller@fnal.gov's local checkout.
#
# Key pattern: <detector>_<runX>_<type>, type in {cvmc, dirt, data}.
# SBND is entirely run1. ICARUS is run2 and run4.
#
# ICARUS run2/run4 pairs (and the two icarus_data lines) intentionally
# point at the SAME physical file per type: Run 2 and Run 4 are read out
# of one underlying production file, but PROfit needs each to see a
# distinct path, so both are aliased explicitly here instead of relying
# on one "primary" name plus a manually-made symlink for the other.

# --- SBND Run 1 ---
sbnd_run1_cvmc=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_sbnd_v1.1.0_wsyst.root
sbnd_run1_dirt=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_sbnd_v1.1.0_dirt_wsyst.root
sbnd_run1_data=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_sbnd_v1.1.0_sbnd_access_DONOTLOOK.root
# CV-reweighted beam sample (cvwgt injected by reweight/; holds only events/sbnd_large/{selected,multisigma,multisim}).
# sbnd_run1_cvmc stays the full wsyst file: the offbeam and nonmatched trees are read from it.
sbnd_run1_cvrw=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_sbnd_v1.1.0_wsyst_cvrw.root
# detvar CV/DENT samples (no weights); used directly by the DENT study's Tier A
sbnd_run1_detvar=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_sbnd_v1.1.0_detvar_nosyst.root

# --- ICARUS Run 2 ---
icarus_run2_cvmc=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run2_v1.1.0_wsyst.root
icarus_run2_dirt=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run2_v1.1.0_dirt_wsyst.root
icarus_run2_data=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run2_v1.1.0_bnblight.root
# CV-reweighted beam sample (cvwgt injected by reweight/; holds only events/icarus_run2/{selected,multisigma,multisim})
icarus_run2_cvrw=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run2_v1.1.0_wsyst_cvrw.root

# --- ICARUS Run 4 ---
icarus_run4_cvmc=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run4_v1.1.0_wsyst.root
icarus_run4_dirt=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run4_v1.1.0_dirt_wsyst.root
icarus_run4_data=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run4_v1.1.0_bnblight.root
# CV-reweighted beam sample (cvwgt injected by reweight/; holds only events/icarus_run4/{selected,multisigma,multisim})
icarus_run4_cvrw=/Users/mueller/data/spineosc/v1.1.0/spineosc_numu_icarus_run4_v1.1.0_wsyst_cvrw.root

