# Fake-data FREE fits (oscillation floating) - pairs with scan_fakedata_null.
# Submit only after the null job has FINISHED (check:
#   ls $output_root/contours_full/data__*/contours_full_data.bin | wc -l   -> 14)
#
#   scripts/submit_fanout.sh --queue capacity --walltime 01:00:00 \
#       --variants jobs/contours/scan_fakedata_free.variants jobs/contours/contours_full.ini -- global
#
# label                                   sections
