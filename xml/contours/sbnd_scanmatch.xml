    <allowlist type="spline"  apply_to_subchannel="_(target|othercc|nuecc|nc)$" binning="var2" plotname="VecFFCCQEshape" tag="Cross-Section-QE">GENIEReWeight_SBN_v1_multisigma_VecFFCCQEshape</allowlist>
    <allowlist type="spline"  apply_to_subchannel="_(target|othercc|nuecc|nc)$" binning="var2" plotname="CoulombCCQE" tag="Cross-Section-QE">GENIEReWeight_SBN_v1_multisigma_CoulombCCQE</allowlist>
