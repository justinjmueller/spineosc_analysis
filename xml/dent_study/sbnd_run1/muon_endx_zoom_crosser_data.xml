<?xml version="1.0" ?>

<!--
DETECTOR-ACCESS comparison: SBND Run 1, muon_endx, split by cathode-crosser
status, area normalized. Data companion to muon_endx_zoom_crosser.xml -- see
that file for the stay/xing definition and purpose.
-->

<mode name="nu" />

<!--
This is a two-detector analysis, so we need to specify both detectors here. We
have:
 - SBND:   110 m baseline (near detector)
 - ICARUS: 600 m baseline (far detector)
Additionally, this is where we specify the target POT for each detector, which
are not necessarily identical. These values are used as the target POT when
scaling the MC samples for each detector. The MC samples in general have a very
different POT than the target POT.

Here, the POT matches the development sample POT in data for SBND and ICARUS Run 2 and Run 4:
-->
<detector name="SBND" pot="1.0e+19" />

<!--
Configure the model used within PROfit to a simple two-flavor (nu_mu) neutrino
disappearance model. This is the model used for the oscillation fit in this
analysis.
-->
<model tag="numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Dis"/>
    <parameter name="L/E" variable_index="1"/>
</model>

<!--
Data overlay companion for coverage/muon_endx_sbnd.xml
- data carries no interaction-model systematics
Two channels split by reconstructed proton multiplicity (ccqelike = 1p,
nproton = Np), each with a single flat "data" subchannel. Reco-level
selection only - no truth-level cuts - and no systematics.

ICARUS data (events/icarus_bnblight_run2, events/icarus_bnblight_run4) is
already split into separate per-run trees upstream, so it gets two MCFile
blocks (detector="ICARUSRun2"/"ICARUSRun4").
-->

<channel name="stay" unit="Reconstructed Muon End X [cm]">

    <bins unit="Muon End X [cm]" edges="-50 -45 -40 -35 -30 -25 -20 -15 -10 10 15 20 25 30 35 40 45 50"/>
    <bins unit="True L/E"     min="0.0" max="3.0" nbins="300" plot="false"/>
    <bins unit="True E [GeV]" min="0.3" max="3.0" nbins="20"  plot="false"/>
    <bins unit="RecoE" edges="0.3 0.4 0.46 0.52 0.58 0.64 0.7 0.76 0.82 0.88 0.94 1.0 1.06 1.13 1.2 1.3 1.5" plot="false"/>
    <bins unit="Count"        min="0.0" max="1.0" nbins="1"/>

    <subchannel name="data" plotname="Data" color="#FBBC04"/>

</channel>
<channel name="xing" unit="Reconstructed Muon End X [cm]">

    <bins unit="Muon End X [cm]" edges="-50 -45 -40 -35 -30 -25 -20 -15 -10 10 15 20 25 30 35 40 45 50"/>
    <bins unit="True L/E"     min="0.0" max="3.0" nbins="300" plot="false"/>
    <bins unit="True E [GeV]" min="0.3" max="3.0" nbins="20"  plot="false"/>
    <bins unit="RecoE" edges="0.3 0.4 0.46 0.52 0.58 0.64 0.7 0.76 0.82 0.88 0.94 1.0 1.06 1.13 1.2 1.3 1.5" plot="false"/>
    <bins unit="Count"        min="0.0" max="1.0" nbins="1"/>

    <subchannel name="data" plotname="Data" color="#FBBC04"/>

</channel>

<MCFile treename="events/sbnd_bnblight_full/selected" filename="work/sbnd_run1_dataaccess.root" scale = "1.0" pot="1.0e+19">
    <branch
        associated_subchannel = "nu_SBND_stay_data"
        model_rule            = "0"
        additional_weight     = "(reco_proton_multiplicity >= 1) && (reco_fiducialize_cathode == 1) && (reco_veto_sbnd_highy_highz == 1) && (reco_vertex_x * reco_leading_muon_end_x) >= 0"
    >
        <variable>reco_leading_muon_end_x</variable>
        <variable>0</variable>
        <variable>0</variable>
        <variable>0</variable>
        <variable>0.5</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_xing_data"
        model_rule            = "0"
        additional_weight     = "(reco_proton_multiplicity >= 1) && (reco_fiducialize_cathode == 1) && (reco_veto_sbnd_highy_highz == 1) && (reco_vertex_x * reco_leading_muon_end_x) < 0"
    >
        <variable>reco_leading_muon_end_x</variable>
        <variable>0</variable>
        <variable>0</variable>
        <variable>0</variable>
        <variable>0.5</variable>
    </branch>
</MCFile>

