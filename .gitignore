# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# spineosc runtime output
output/
autogen_*.xml
autogen_*.ini
# ... but the reviewed golden snapshots are part of the test suite
!tests/golden/**

# spineosc deploy (scripts/deploy.sh): per-machine file map and the
# symlink work directory it populates. input/sources.list.example stays
# tracked as the template.
/work/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Notebooks
notebooks/*

# Claude
.claude/

# Archived configs
config/archive

# Specific to this project
detsys/profit_systematics*/*.root
*.bin
*.pdf
*PROplot*.root
*_surf.root
*log

# fake-data tooling
spinefd/.geproj/
archive/

# ---------------------------------------------------------------------------
# Run products. PROfit writes these into the working directory (the repo root when run
# from there), and `runs/` holds the per-study run directories (tens of GB). All of it is
# reproducible from the XMLs, the generators and the inputs, so none of it is tracked.
/runs/
/*.root
/*.bin
/*.pdf
/*.png
/*.txt
/*.log
/test_*

# Figure previews written next to the analysis notes are regenerated by their scripts;
# the markdown, JSON and CSV in docs/ are tracked. The DENT study report embeds its figures.
/docs/**/*.png
!/docs/dent_study/figures/**

# Compiled executables, notebook-run scratch and archive junk
/reweight/run_reweight
/detsys/calculator*/run_detsys*
/docs/**/*.pkl
/docs/**/*.zip
/docs/**/*.aux
/docs/**/*.toc
/docs/**/*.out
/docs/**/*.log
